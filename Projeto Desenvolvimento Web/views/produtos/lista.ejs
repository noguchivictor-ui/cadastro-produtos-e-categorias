<%- include('../partials/cabecalho') %>

<h2>Produtos</h2>
<p><a href="/produtos/novo">+ Novo produto</a></p>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>nome</th>
            <th>Preco</th>
            <th>Categoria</th>
            <th>Acoes</th>
        </tr>
    </thead>
    <tbody>
    <% produtos.forEach(produto => { %>
        <tr>
            <td><%= produto.id %></td>
            <td><%= produto.nome %></td>
            <td>R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></td>
            <td><%= produto.categoria ? produto.categoria.nome : '-' %></td>
            <td>
                <a href="/produtos/editar/<%= produto.id %>">editar</a>
                <form action="/produtos/excluir/<%= produto.id %>" method="POST" class="em-linha">
                    <button type="submit">excluir</button>
                </form>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
<% if (produtos.length === 0) { %><p>Nenhum produto cadastrado.</p><% } %>

<%- include('../partials/rodape') %>
